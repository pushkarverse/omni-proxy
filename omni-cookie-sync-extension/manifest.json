{
  "manifest_version": 3,
  "name": "Omni Cookie Sync",
  "version": "1.0",
  "description": "Exports Gemini & ChatGPT cookies plus XSRF/build metadata for gemini-web2api.",
  "permissions": [
    "cookies",
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*"
  ],
  "action": {
    "default_title": "Omni Cookie Sync",
    "default_popup": "popup.html"
  }
}
